# Copy to .env.local and fill in. Never commit real secrets.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Owner bootstrap (scripts only)
OWNER_EMAIL=kishore@igniteinteriordecor.com
OWNER_NAME=Kishore
OWNER_PASSWORD=

# Development demo data (scripts only; refuse to run unless SEED_DEMO=true)
SEED_DEMO=false
DEMO_USER_PASSWORD=

# End-to-end tests (Playwright; optional — tests skip when unset). Use non-production test accounts.
E2E_BASE_URL=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SM_EMAIL=
E2E_SM_PASSWORD=
